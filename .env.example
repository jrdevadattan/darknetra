# FastAPI runtime
DARKNETRA_ENVIRONMENT=development
DARKNETRA_BUILD_VERSION=dev
DARKNETRA_WEB_ORIGIN=http://localhost:3000
# Required for auth. Generate 32 random bytes and base64-encode them; never commit the value.
DARKNETRA_JWT_SIGNING_KEY_B64=

# Required by features that store sensitive fields. Supply runtime-only 32-byte Base64 secrets.
# For rotation, the JSON object must retain every key version referenced by live data or backups.
# Never commit real values. The legacy v1 variable remains supported during migration.
DARKNETRA_FIELD_KEY_V1_B64=
DARKNETRA_FIELD_KEYRING_B64_JSON=
DARKNETRA_FIELD_BLIND_INDEX_KEY_B64=
DARKNETRA_FIELD_ACTIVE_KEY_VERSION=v1

# PostgreSQL development configuration. API/worker receive only the runtime URL.
# Alembic receives the owner URL separately; never expose it to application containers.
DARKNETRA_POSTGRES_PASSWORD=darknetra-dev-only
DARKNETRA_POSTGRES_RUNTIME_PASSWORD=darknetra-runtime-dev-only
DARKNETRA_DATABASE_URL=postgresql+psycopg://darknetra_runtime:darknetra-runtime-dev-only@127.0.0.1:5432/darknetra
DARKNETRA_DATABASE_OWNER_URL=postgresql+psycopg://darknetra:darknetra-dev-only@127.0.0.1:5432/darknetra

# Transient Celery broker only. PostgreSQL remains authoritative for job status/history.
DARKNETRA_REDIS_URL=redis://127.0.0.1:6379/0

# Next.js server-side API URL
DARKNETRA_API_BASE_URL=http://127.0.0.1:8000

# Browser-visible API URL. Match DARKNETRA_WEB_ORIGIN's hostname for SameSite=Strict cookies.
# Never put secrets in NEXT_PUBLIC_* values.
NEXT_PUBLIC_DARKNETRA_API_BASE_URL=http://localhost:8000

# One-time CLI input only; supply through the environment or interactive prompt, never commit it.
# DARKNETRA_BOOTSTRAP_ADMIN_PASSWORD=
