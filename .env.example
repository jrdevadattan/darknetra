# Optional overrides. Copy this file to frontend/.env.local.
# Native Codex executable path; defaults to codex on PATH.
CODEX_BIN=
# Leave empty to use the Codex CLI default model.
CODEX_MODEL=
# Absolute storage directory; default is frontend/.codex-chat.
CODEX_CHAT_DATA_DIR=
# Optional local Tor proxy for the CLI's Robin skill; native default below.
# Docker Compose sets socks5h://research:9050 automatically.
DARKNETRA_TOR_SOCKS_URL=socks5h://127.0.0.1:9050
# DARKNETRA_INPUT_DIR is assigned per chat by the app; do not set it globally.
# Dedicated Telegram bot for the operator-administered group/channel.
# Put private values in ignored frontend/.env.local; Docker reads this optional file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# DARKNETRA_TELEGRAM_READ_ONLY is assigned by the web-chat bridge; do not override it.
# Docker Compose only: optional host auth.json path (defaults to USERPROFILE/.codex/auth.json).
# CODEX_AUTH_FILE=
# CODEX_HOME may also be set to an existing signed-in Codex home.
# Optional Web Push VAPID contact URI (mailto: or https:). Local default: https://darknetra.invalid.
# Keys and browser subscriptions are generated once in CODEX_CHAT_DATA_DIR/push-private.json.
DARKNETRA_VAPID_SUBJECT=
# Commercial intelligence credentials stay in a local JSON file, outside chats.
# Copy frontend/providers.example.json to frontend/.codex-chat/providers.json.
# Docker already maps that location. For native use an absolute file path here.
# Keys are read by CLI helpers, never placed in prompts or browser storage.
DARKNETRA_PROVIDER_FILE=
# Optional standalone helper overrides (the file above is preferred for web chats):
# FLASHPOINT_API_TOKEN=
# RECORDED_FUTURE_API_TOKEN=
# CHAINALYSIS_API_KEY=
# APIFY_API_TOKEN=
# Optional native CLI model runtime. Docker includes its own Python 3.12 CPU runtime.
# DARKNETRA_ML_PYTHON=/absolute/path/to/python3.12
