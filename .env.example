# Run: uv run --project backend python scripts/setup.py
# setup.py generates unique local secrets; never commit the resulting .env.
DARKNETRA_ENV=development
DARKNETRA_BUILD_VERSION=dev
DARKNETRA_DB_APP_PASSWORD=
DARKNETRA_DB_MIGRATE_PASSWORD=
DARKNETRA_DATABASE_URL=postgresql+psycopg://darknetra_app:CHANGE_ME@127.0.0.1:55432/darknetra
DARKNETRA_MIGRATION_DATABASE_URL=postgresql+psycopg://darknetra_migrate:CHANGE_ME@127.0.0.1:55432/darknetra
DARKNETRA_TEST_DATABASE_URL=postgresql+psycopg://darknetra_migrate:CHANGE_ME@127.0.0.1:55432/darknetra_test
DARKNETRA_JWT_SIGNING_KEY_B64=
DARKNETRA_FIELD_KEY_B64=
DARKNETRA_VAULT_PATH=./vault
DARKNETRA_WEB_ORIGIN=http://localhost:3000
DARKNETRA_ACCESS_TTL_SECONDS=900
DARKNETRA_REFRESH_TTL_SECONDS=28800
DARKNETRA_MAX_UPLOAD_BYTES=209715200
DARKNETRA_MAX_ZIP_BYTES=524288000
DARKNETRA_LOG_LEVEL=INFO

# Explicit offline development. Deterministic mode quotes captured evidence.
DARKNETRA_DEMO_MODE=true
DARKNETRA_OFFLINE_MODE=true
DARKNETRA_HARNESS_MODE=deterministic
DARKNETRA_SCHEDULER_ENABLED=true
DARKNETRA_MONITOR_INTERVAL_OVERRIDE=
DARKNETRA_TRIAGE_MODEL_ENABLED=false
DARKNETRA_EMBEDDING_MODEL=BAAI/bge-m3
DARKNETRA_EMBEDDING_DIM=1024
# Local-only optional embeddings; install the embed extra and provision a 1024-d model directory.
DARKNETRA_EMBEDDING_BACKEND=none
DARKNETRA_EMBEDDING_MODEL_PATH=
DARKNETRA_EMBEDDING_BATCH_SIZE=32
DARKNETRA_EMBEDDING_TIMEOUT_SECONDS=60
DARKNETRA_CASE_LEAD_MODEL=claude-opus-5
DARKNETRA_WORKER_MODEL=claude-sonnet-5
DARKNETRA_OLLAMA_URL=http://127.0.0.1:11434
DARKNETRA_OFFLINE_MODEL=qwen3:8b
# Optional provider/model credentials. Unconfigured services report unavailable.
DARKNETRA_ANTHROPIC_API_KEY=
DARKNETRA_ANTHROPIC_API_KEY_BACKUP=
# NVIDIA NIM OpenAI-compatible endpoint. Rates are USD per million tokens;
# leave rates empty when billing is unknown so usage is marked incomplete.
DARKNETRA_NIM_BASE_URL=
DARKNETRA_NIM_API_KEY=
DARKNETRA_NIM_MODEL=
DARKNETRA_NIM_WORKER_MODEL=
DARKNETRA_NIM_TIMEOUT_SECONDS=120
DARKNETRA_NIM_MAX_TOKENS=4096
DARKNETRA_NIM_INPUT_COST_PER_MILLION=
DARKNETRA_NIM_OUTPUT_COST_PER_MILLION=
# NIM requires both rates for USD budget enforcement; explicitly use 0 only for a free deployment.
DARKNETRA_TAVILY_API_KEY=
DARKNETRA_CHAINALYSIS_API_KEY=
DARKNETRA_TRONGRID_API_KEY=
DARKNETRA_ETHERSCAN_API_KEY=
DARKNETRA_APIFY_TOKEN=
DARKNETRA_APIFY_TELEGRAM_ACTOR=
DARKNETRA_MCP_GATEWAY_URL=
DARKNETRA_TOR_SOCKS_URL=
# Optional public HTTPS SearXNG base URL with GET JSON enabled; no credentials/query.
DARKNETRA_SURFACE_SEARCH_SEARXNG_URL=
# Standalone MCP: one existing case and a revocable service API token (never a login subscription).
DARKNETRA_MCP_CASE_ID=
DARKNETRA_MCP_API_TOKEN=

# Used by CLI/dev scripts; never exposed through the settings API.
DARKNETRA_BOOTSTRAP_ADMIN_PASSWORD=
DARKNETRA_ADMIN_PASSWORD=
DARKNETRA_DEMO_ANALYST_PASSWORD=
