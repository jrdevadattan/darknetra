{
  "name": "darknetra-workspace",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "api:types": "openapi-typescript ../docs/openapi.json -o lib/generated/api.d.ts",
    "prepare": "npm run api:types",
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "npm run api:types && next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "npm run api:types && next typegen --webpack && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write app components/workspace lib --ignore-path .prettierignore"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.0",
    "@fontsource-variable/geist-mono": "^5.2.0",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/postcss": "^4.1.0",
    "@tanstack/react-query": "^5.90.0",
    "@xyflow/react": "^12.11.0",
    "ai": "^6.0.0",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.577.0",
    "motion": "^13.2.0",
    "nanoid": "^6.0.1",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "shiki": "^4.4.3",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "overrides": {
    "ansi-to-react": {
      "linkify-it": "^5.0.2"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.7.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7"
  }
}
